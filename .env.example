# Firebase web config — copy these from Firebase console → Project settings → Your apps → SDK setup and configuration.
# Leave VITE_FIREBASE_DATABASE_URL empty to run with local mock data only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mahsaims.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=mahsaims
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
